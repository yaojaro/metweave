{
  "name": "@metweave/parser",
  "version": "0.3.0",
  "description": "Tolerant METAR/SPECI parser to a JSON IR — unknown groups and missing values are never silent: warnings carry source spans, missing codes map to explicit states.",
  "keywords": [
    "aviation",
    "metar",
    "parser",
    "report",
    "speci",
    "tolerant",
    "weather"
  ],
  "homepage": "https://github.com/yaojaro/metweave#readme",
  "bugs": {
    "url": "https://github.com/yaojaro/metweave/issues"
  },
  "license": "MIT",
  "author": "YaoJaro <yaojaro@metweave.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaojaro/metweave.git",
    "directory": "packages/parser"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "mw-dist": {
        "import": "./dist/index.js"
      },
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./iwxxm": {
      "types": "./src/iwxxm.ts",
      "mw-dist": {
        "import": "./dist/iwxxm.js"
      },
      "import": "./src/iwxxm.ts",
      "require": "./src/iwxxm.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./iwxxm": {
        "import": {
          "types": "./dist/iwxxm.d.ts",
          "default": "./dist/iwxxm.js"
        },
        "require": {
          "types": "./dist/iwxxm.d.cts",
          "default": "./dist/iwxxm.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metweave/core": "workspace:*",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "^26"
  },
  "engines": {
    "node": ">=20"
  }
}
