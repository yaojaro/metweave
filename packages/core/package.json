{
  "name": "@metweave/core",
  "version": "0.1.1",
  "description": "The stable data contract for METAR/SPECI pipelines: a JSON-serializable IR with three-state missing values, source spans and machine-readable warnings.",
  "keywords": [
    "data-model",
    "ir",
    "metar",
    "observation",
    "speci",
    "weather"
  ],
  "license": "MIT",
  "author": "YaoJaro <yaojaro@metweave.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaojaro/metweave.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "mw-dist": {
        "import": "./dist/index.js"
      },
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}
