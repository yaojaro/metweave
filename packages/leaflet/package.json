{
  "name": "@metweave/leaflet",
  "version": "0.1.0",
  "description": "Put parsed METAR/SPECI reports on a Leaflet map: markers, tooltips and report-card popups in one call — bring your own tiles.",
  "keywords": [
    "leaflet",
    "map-layer",
    "marker",
    "metar",
    "popup",
    "weather"
  ],
  "license": "MIT",
  "author": "YaoJaro <yaojaro@metweave.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaojaro/metweave.git",
    "directory": "packages/leaflet"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metweave/core": "workspace:*",
    "@metweave/render": "workspace:*"
  },
  "devDependencies": {
    "@metweave/parser": "workspace:*",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
