{
  "name": "@metweave/render",
  "version": "0.1.0",
  "description": "metweave rendering layer: an in-house Canvas-2D-first kernel (context-injected, DOM-free) and domain weather components.",
  "license": "MIT",
  "author": "YaoJaro <yaojaro@metweave.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaojaro/metweave.git",
    "directory": "packages/render"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metweave/core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
