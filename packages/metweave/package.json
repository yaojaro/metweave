{
  "name": "metweave",
  "version": "0.3.0",
  "description": "METAR parsing, report cards and public-source fetchers in one entry — pair it with @metweave/leaflet (the map adapter) to put live airport weather on a map in ten lines.",
  "keywords": [
    "airport",
    "aviation",
    "leaflet",
    "map",
    "metar",
    "observation",
    "speci",
    "visualization",
    "weather"
  ],
  "homepage": "https://github.com/yaojaro/metweave#readme",
  "bugs": {
    "url": "https://github.com/yaojaro/metweave/issues"
  },
  "license": "MIT",
  "author": "YaoJaro <yaojaro@metweave.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaojaro/metweave.git",
    "directory": "packages/metweave"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "mw-dist": {
        "import": "./dist/index.js"
      },
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./sources": {
      "types": "./src/sources.ts",
      "mw-dist": {
        "import": "./dist/sources.js"
      },
      "import": "./src/sources.ts",
      "require": "./src/sources.ts"
    },
    "./stations-cn": {
      "types": "./src/stations-cn.ts",
      "mw-dist": {
        "import": "./dist/stations-cn.js"
      },
      "import": "./src/stations-cn.ts",
      "require": "./src/stations-cn.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./sources": {
        "import": {
          "types": "./dist/sources.d.ts",
          "default": "./dist/sources.js"
        },
        "require": {
          "types": "./dist/sources.d.cts",
          "default": "./dist/sources.cjs"
        }
      },
      "./stations-cn": {
        "import": {
          "types": "./dist/stations-cn.d.ts",
          "default": "./dist/stations-cn.js"
        },
        "require": {
          "types": "./dist/stations-cn.d.cts",
          "default": "./dist/stations-cn.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metweave/core": "workspace:*",
    "@metweave/parser": "workspace:*",
    "@metweave/render": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
