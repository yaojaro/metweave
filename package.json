{
  "name": "metweave-monorepo",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "lint": "oxlint --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "build": "pnpm -r --filter '!metweave-examples' run build",
    "build:examples": "pnpm --filter metweave-examples run build",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:leaks": "node scripts/check-leaks.mjs --all",
    "check:docs": "node scripts/check-docs-chinese.mjs",
    "replay:corpus": "node scripts/replay-corpus.mjs corpus/*.txt --baseline corpus/snapshot.json",
    "check:knip": "knip",
    "check:artifact": "rm -rf node_modules/.artifacts && pnpm -r --filter '!metweave-monorepo' --filter '!metweave-examples' pack --pack-destination node_modules/.artifacts && for f in node_modules/.artifacts/*.tgz; do publint \"$f\" && attw --profile node16 \"$f\" || exit 1; done && for f in node_modules/.artifacts/*.tgz; do tar -tzf \"$f\" | grep -qx \"package/LICENSE\" || { echo \"缺 LICENSE: $f\"; exit 1; }; done",
    "fuzz": "node scripts/fuzz.mjs",
    "gen:stations": "node scripts/generate-stations.mjs",
    "gen:unknown": "node scripts/gen-unknown-shapes.mjs",
    "publish:all": "pnpm build && pnpm check:artifact && pnpm -r publish --access public",
    "gen:terms": "node scripts/terms.mjs gen --write",
    "check:terms": "node scripts/terms.mjs check",
    "ci:rehearsal": "node scripts/ci-rehearsal.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "happy-dom": "^20.14.3",
    "knip": "^6.35.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0"
}
