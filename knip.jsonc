{
  "$schema": "./node_modules/knip.schema.json",
  "workspaces": {
    ".": {
      // code/：教程《风不是一个数》配套取数脚本——读者侧独立入口，不被仓内任何
      // 模块引用，显式登记为 entry，否则 knip 判未用文件
      "entry": ["code/fetch.mjs", "code/rose.mjs", "code/barbs-batch.mjs"],
    },
    "packages/metweave": {},
    // examples 全部页面入口由 vite 插件解析（vite.config.ts build.rollupOptions.input
    // 登记八页 html，html 引的脚本与 config 引用的 gen-grid-api.ts 均可达）——
    // 不再显式登记 src/iwxxm-main.ts（knip 判其冗余，登记反出 Configuration hint）
    "examples": {},
  },
}
